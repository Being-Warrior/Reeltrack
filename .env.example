# Database
DATABASE_URL="postgresql://reeltrack:reeltrack@localhost:5432/reeltrack?schema=public"

# Auth.js
AUTH_SECRET="generate-a-32-character-secret"
AUTH_URL="http://localhost:3000"

# Required in production to protect the scheduled catalog and release refresh.
CRON_SECRET="generate-a-long-random-secret"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# TMDB — server only, never expose to the client
TMDB_API_KEY=""
TMDB_ACCESS_TOKEN=""

# Optional email (verification / password reset). Logs to console in development if unset.
EMAIL_FROM="ReelTrack <noreply@reeltrack.app>"
RESEND_API_KEY=""

# Optional local admin dashboard
ADMIN_EMAIL=""
