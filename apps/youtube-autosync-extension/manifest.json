{
  "manifest_version": 3,
  "name": "ReelTrack AutoSync for YouTube",
  "version": "0.1.3",
  "description": "Privately syncs YouTube playback activity to your ReelTrack account.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "http://localhost:3000/*", "https://reeltrack-virid.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "ReelTrack AutoSync", "default_popup": "popup.html" },
  "content_scripts": [{ "matches": ["https://www.youtube.com/*"], "js": ["youtube.js"], "run_at": "document_idle", "all_frames": true }]
}
